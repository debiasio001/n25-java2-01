				gam.getPlayers().add(pla); // adicionando ao jogo
				//lançando 2 cartas
				gam.solicitarCarta(gam.getPlayers().size()-1);
				gam.solicitarCarta(gam.getPlayers().size()-1);
			}
			
		}while (!nomeJogador.equals("sair") && 
